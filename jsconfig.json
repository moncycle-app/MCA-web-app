{
	"compilerOptions": {
		"checkJs": true,
		"allowJs": true,
		"noEmit": true,
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": { "/*": ["./src/*"] },
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": false
	},
	"include": ["src/js", "src/screens", "src/*.d.ts"],
	"exclude": ["src/vendor"]
}
